{
  "openapi": "3.0.3",
  "info": {
    "title": "Fragment Donor Public API",
    "version": "0.1.0",
    "description": "Independent service, not an official Telegram, Fragment, or TON product. No service authentication. Default shared quota: 30 requests per IP per minute across all endpoints. Credential-bearing requests are server-side only. The inspected backend stores submitted purchase credentials.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/usnuz/fragment-donor-sdk/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://fragment.donor.uz"
    }
  ],
  "security": [],
  "paths": {
    "/get-user-info/": {
      "get": {
        "operationId": "getUserInfo",
        "summary": "Check Telegram username and Premium status",
        "security": [],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^@?[A-Za-z][A-Za-z0-9_]{3,31}$",
              "example": "durov"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details; additional fields are preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "username": {
                      "type": "string"
                    },
                    "is_premium": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or upstream purchase failure; error details may appear in error, reason, or info.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "info": {},
                    "retry_after": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "flood_wait": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tx_hash": {
                      "type": "string"
                    },
                    "transient": {
                      "type": "boolean"
                    },
                    "unconfirmed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "FLOOD_WAIT: wait retry_after seconds. No automatic purchase retries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "info": {},
                    "retry_after": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "flood_wait": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tx_hash": {
                      "type": "string"
                    },
                    "transient": {
                      "type": "boolean"
                    },
                    "unconfirmed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Whole seconds to wait.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "503": {
            "description": "RATE_LIMIT_UNAVAILABLE: safety limiter unavailable; no automatic purchase retries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "error": {
                      "type": "string"
